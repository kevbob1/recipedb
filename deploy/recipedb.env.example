# recipedb container environment.
#
# Install as /srv/recipedb/env (outside the repo, never committed):
#   install -m 600 deploy/recipedb.env.example /srv/recipedb/env
#   $EDITOR /srv/recipedb/env
#
# Docker's --env-file does NOT expand variables: paste literal values.

# argon2id hash of the family password.
# Generate it with the image (no host install needed):
#   docker run --rm --entrypoint node recipedb:0.1 \
#     -e 'const {hash}=require("@node-rs/argon2");hash(process.argv[1]).then(h=>console.log(h))' \
#     'YOUR_PASSWORD'
FAMILY_PASSWORD_HASH=$argon2id$v=19$m=19456,t=2,p=1$REPLACE_SALT$REPLACE_HASH

# Session signing secret: openssl rand -base64 32
SESSION_SECRET=REPLACE_WITH_OPENSSL_RAND_BASE64_32

PORT=3000
DATA_DIR=/data
NODE_ENV=production
