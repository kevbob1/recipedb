{
  "name": "recipedb",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build && esbuild app/server-boot.ts --bundle --platform=node --format=esm --packages=external --outfile=build/server/boot.mjs",
    "start": "node server.js",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx app/db/migrate.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@react-router/node": "^7.9.5",
    "better-sqlite3": "^12.11.1",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.40.0",
    "isbot": "^5.1.20",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.9.5",
    "recipe-scrapers": "^3.2.0",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@react-router/dev": "^7.9.5",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.30.0",
    "esbuild": "^0.19.12",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.5"
  }
}
