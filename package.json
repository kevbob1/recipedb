{
  "name": "recipedb",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build && esbuild app/server-boot.ts --bundle --platform=node --format=esm --packages=external --outfile=build/server/boot.mjs",
    "start": "node server.js",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:patch": "npm run test:coverage && node scripts/patch-coverage.mjs",
    "verify": "make check && echo VERIFY_OK",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx app/db/migrate.ts",
    "db:backfill-quantity": "tsx scripts/backfill-quantity.ts"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@react-router/node": "^7.9.5",
    "better-sqlite3": "^12.11.1",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.4",
    "fraction.js": "^5.3.4",
    "isbot": "^5.1.20",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.9.5",
    "recipe-scrapers": "^3.2.0",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@react-router/dev": "^7.9.5",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^26",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^4.1.12",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.12"
  }
}
